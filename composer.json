{
    "name": "phpsoftbox/container",
    "description": "Dependency injection container for the PhpSoftBox framework",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Anton K.",
            "email": "inspector-who@mail.ru"
        }
    ],
    "config": {
        "sort-packages": true
    },
    "require": {
        "php": "^8.5",
        "phpsoftbox/profiler": "^1.0",
        "psr/container": "^2.0"
    },
    "require-dev": {
        "phpsoftbox/cli-app": "^1.0",
        "phpsoftbox/cs-fixer": "^1.2.2",
        "phpsoftbox/env": "^1.0",
        "phpunit/phpunit": "^13.3"
    },
    "suggest": {
        "phpsoftbox/env": "Lets the env() definition helper read values loaded from .env into EnvStorage."
    },
    "autoload": {
        "psr-4": {
            "PhpSoftBox\\Container\\": "src/"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "PhpSoftBox\\Container\\Tests\\": "tests/"
        }
    },
    "extra": {
        "psb": {
            "providers": [
                "PhpSoftBox\\Container\\Cli\\ContainerCommandProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit",
        "cs:fix": "vendor/bin/psb-cs-fixer fix",
        "cs:check": "vendor/bin/psb-cs-fixer check --diff"
    },
    "prefer-stable": true
}
